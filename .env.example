# Copy to .env and fill in. Keys can also be entered in Settings (stored encrypted in the database).

# --- server ---
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000
# Public URL of this server. Must match the OAuth redirect URI you register with Google:
#   <CLIPFORGE_BASE_URL>/api/youtube/callback
CLIPFORGE_BASE_URL=http://localhost:8000
CLIPFORGE_DATA=./data
CLIPFORGE_WORKERS=2
CLIPFORGE_ALLOW_SIGNUP=0
CLIPFORGE_MAX_UPLOAD_MB=4096
CLIPFORGE_SOURCE_RETENTION_DAYS=3
CLIPFORGE_STORAGE_MAX_GB=50

# --- LLM agent (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- speech recognition ---
# Local engines (pip install faster-whisper) are used automatically if present; otherwise a hosted Whisper-compatible API.
LOCAL_WHISPER_MODEL=base
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1

# --- YouTube publishing (Google Cloud Console > OAuth client, type "Web application", YouTube Data API v3 enabled) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
